{
  "opencollection": "1.0.0",
  "info": {
    "name": "Didomi consents/events taxonomies API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "taxonomies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of taxonomy items for vendors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/taxonomies/vendors",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of taxonomy items for vendors"
        },
        {
          "info": {
            "name": "Create a taxonomy item for vendors",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.didomi.io/v1/taxonomies/vendors",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new taxonomy item"
        },
        {
          "info": {
            "name": "Retrieve a taxonomy item for vendors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/taxonomies/vendors/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the item to retrieve"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single taxonomy item"
        },
        {
          "info": {
            "name": "Update a taxonomy item for vendors",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.didomi.io/v1/taxonomies/vendors/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the item to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing taxonomy item"
        },
        {
          "info": {
            "name": "Patch a taxonomy item for vendors",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.didomi.io/v1/taxonomies/vendors/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the item to patch"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Partially update a taxonomy item"
        },
        {
          "info": {
            "name": "Delete a taxonomy item for vendors",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.didomi.io/v1/taxonomies/vendors/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the item to delete"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an item"
        }
      ]
    }
  ],
  "bundled": true
}
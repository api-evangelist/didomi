{
  "opencollection": "1.0.0",
  "info": {
    "name": "Didomi consents/events partners API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "partners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of partners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/metadata/partners",
            "params": [
              {
                "name": "url",
                "value": "",
                "type": "query",
                "description": "An URL to match to a partner. This parameter can be repeated multiple times to identify multiple partners at once."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of partners"
        },
        {
          "info": {
            "name": "Create a partner",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.didomi.io/v1/metadata/partners",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new partner"
        },
        {
          "info": {
            "name": "Retrieve a partner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/metadata/partners/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the partner to retrieve"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single partner with the given ID"
        },
        {
          "info": {
            "name": "Update a partner",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.didomi.io/v1/metadata/partners/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the partner to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing a partner"
        },
        {
          "info": {
            "name": "Patch a partner",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.didomi.io/v1/metadata/partners/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the partner to patch"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Partially update the partner"
        },
        {
          "info": {
            "name": "Delete a partner",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.didomi.io/v1/metadata/partners/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the partner to delete"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete the partner"
        }
      ]
    }
  ],
  "bundled": true
}
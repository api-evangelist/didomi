{
  "opencollection": "1.0.0",
  "info": {
    "name": "Didomi consents/events languages API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "languages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve list of available languages/locales",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/languages",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns list of available languages/locales"
        }
      ]
    }
  ],
  "bundled": true
}
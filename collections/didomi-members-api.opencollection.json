{
  "opencollection": "1.0.0",
  "info": {
    "name": "Didomi consents/events members API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of members of an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/members",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "The ID of the organization"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of members of an organization"
        },
        {
          "info": {
            "name": "Add a user to an organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.didomi.io/v1/members",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a new member to an organization. If the user is new it will send an email with a password reset link. Finally it will send an added to organization notification"
        },
        {
          "info": {
            "name": "Retrieve a member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.didomi.io/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the member to retrieve"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single member of an organization"
        },
        {
          "info": {
            "name": "PATCH /members/{id}",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.didomi.io/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of members to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the resource identified by id using data."
        },
        {
          "info": {
            "name": "Remove a user from an organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.didomi.io/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the member to delete"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an existing member of an organization"
        }
      ]
    }
  ],
  "bundled": true
}